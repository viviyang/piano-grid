{
  "name": "piano-grid",
  "version": "0.1.0",
  "private": true,
  "description": "PianoGrid piano references and practice tools.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:foundation": "node scripts/check-foundation.mjs",
    "check:css": "node scripts/check-css.mjs",
    "check:keyboard-completion": "node --experimental-strip-types scripts/check-keyboard-completion.ts",
    "check:keyboard-practice": "node scripts/check-keyboard-practice.mjs",
    "check:songs-sheet-v2": "node --experimental-strip-types scripts/check-songs-sheet-v2.ts",
    "check:practical-tools": "node --experimental-strip-types scripts/check-practical-tools.ts",
    "check": "npm run check:foundation && npm run typecheck && npm run check:css"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "8.5.23",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3"
  }
}
