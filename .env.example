# Public analytics (optional). When NEXT_PUBLIC_GA_MEASUREMENT_ID is set, GA4 loads
# with Consent Mode default denied until the visitor chooses Allow / No thanks.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
