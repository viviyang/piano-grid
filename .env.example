# Public analytics. When set, GA4 loads automatically (no consent banner).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity project ID from https://clarity.microsoft.com (Settings → Overview).
# Not a secret; it ships in the browser. Production only; skip preview and local dev.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Optional override; defaults to ga4 when a measurement ID is present, otherwise none.
# NEXT_PUBLIC_PIANOGRID_ANALYTICS_PROVIDER=ga4
# NEXT_PUBLIC_PIANOGRID_RELEASE_VERSION=production
